	method any GetItemMaster(string itemId)
		self:EnsureInit()
		return self.Items[itemId]
	end

	method any GetEquipDropPoolForLevel(integer mapReqLevel)
		self:EnsureInit()
		local lv = mapReqLevel or 1
		if lv >= 180 then
			return { "arcane_saber", "arcane_hat", "arcane_top", "arcane_gloves", "arcane_shoes", "absolab_saber", "absolab_hat", "absolab_top", "deimos_warrior_shield" }
		elseif lv >= 160 then
			return { "absolab_saber", "absolab_hat", "absolab_top", "absolab_gloves", "absolab_shoes", "fafnir_sword", "karuta_hat", "karuta_top", "noble_ifia_ring" }
		elseif lv >= 120 then
			return { "fafnir_sword", "karuta_hat", "karuta_top", "deimos_warrior_shield", "pensalir_sword", "pensalir_hat", "pensalir_top", "pensalir_gloves", "pensalir_shoes", "noble_ifia_ring" }
		elseif lv >= 60 then
			return { "sparta", "necro_saber", "deimos_warrior_shield", "pensalir_hat", "pensalir_top", "pensalir_gloves", "pensalir_shoes", "silver_blossom_ring", "noble_ifia_ring" }
		else
			return { "gladius", "pensalir_hat", "pensalir_top", "pensalir_gloves", "pensalir_shoes", "silver_blossom_ring" }
		end
	end

	method string GetPotionIdForLevel(integer mapReqLevel)
		local lv = mapReqLevel or 1
		if lv >= 120 then return "power_elixir"
		elseif lv >= 80 then return "blue_potion"
		elseif lv >= 40 then return "white_potion"
		else return "red_potion"
		end
	end

	method string GetEtcLootIdForLevel(integer mapReqLevel)
		local lv = mapReqLevel or 1
		if lv >= 120 then return "cursed_charm"
		elseif lv >= 60 then return "boar_tooth"
		elseif lv >= 25 then return "slime_bubble"
		else return "mush_cap"
		end
	end

	method any GetJobTierInfo(integer tier)
		self:EnsureInit()
		local t = math.max(0, math.min(4, tier or 0))
		return self.JobTiers[t] or self.JobTiers[0]
	end

	method any GetNextAdvanceTier(integer currentTier, integer level)
		self:EnsureInit()
		local cur = currentTier or 0
		if cur >= 4 then return nil end
		local nxt = self.JobTiers[cur + 1]
		if nxt and level >= nxt.reqLevel then
			return nxt
		end
		return nil
	end

	method any GetSkillInfo(string skillId)
		self:EnsureInit()
		return self.Skills[skillId] or self.Skills.power_strike
	end

	method any GetHuntingMapInfo(string mapName)
		self:EnsureInit()
		for _, m in ipairs(self.HuntingMaps) do
			if m.mapName == mapName then
				return m
			end
		end
		return nil
	end

	method any GetRecommendedHuntingMap(integer level)
		self:EnsureInit()
		local best = self.HuntingMaps[1]
		for _, m in ipairs(self.HuntingMaps) do
			if level >= m.reqLevel then
				best = m
			end
		end
		return best
	end

	method any GetNextLockedHuntingMap(integer level)
		self:EnsureInit()
		for _, m in ipairs(self.HuntingMaps) do
			if level < m.reqLevel then
				return m
			end
		end
		return nil
	end

	method integer GetMaxStar(integer reqLevel)
		if reqLevel >= 140 then return 25 end
		if reqLevel >= 130 then return 20 end
		if reqLevel >= 120 then return 15 end
		if reqLevel >= 110 then return 10 end
		return 8
	end

	method integer GetStarforceMesoCost(integer reqLevel, integer currentStar, boolean safeguard)
		local base = 1000
		local lvFactor = math.max(1, math.floor(reqLevel / 10))
		local cost = 0
		if currentStar < 10 then
			cost = math.floor(base + (lvFactor ^ 2) * (currentStar + 1) * 8)
		elseif currentStar < 15 then
			cost = math.floor(base + (lvFactor ^ 2) * ((currentStar + 1) ^ 2) * 3)
		else
			cost = math.floor(base + (lvFactor ^ 2) * ((currentStar + 1) ^ 2.7) * 2)
		end
		if safeguard and (currentStar == 15 or currentStar == 16) then
			cost = cost * 2
		end
		return cost
	end

	method any GetStarforceBonus(string itemId, integer star)
		self:EnsureInit()
		local master = self.Items[itemId]
		local bonus = { mainStat = 0, att = 0 }
		if not master or star <= 0 then
			return bonus
		end
		local isWeapon = (master.slot == "Weapon")
		local curAtt = master.baseAtt
		for s = 1, star do
			if s <= 15 then
				bonus.mainStat = bonus.mainStat + (s <= 5 and 2 or 3)
				if isWeapon then
					local gain = math.floor(curAtt * 0.02) + 1
					bonus.att = bonus.att + gain
					curAtt = curAtt + gain
				end
			else
				bonus.mainStat = bonus.mainStat + 11
				local attGain = 9 + (s - 16)
				bonus.att = bonus.att + attGain
				curAtt = curAtt + attGain
			end
		end
		return bonus
	end

	method string GetPoolKeyForSlot(string slot)
		if slot == "Weapon" or slot == "SubWeapon" then return "WeaponSub"
		elseif slot == "Emblem" then return "Emblem"
		elseif slot == "Gloves" then return "Gloves"
		elseif slot == "Ring1" then return "Ring"
		end
		return "Armor"
	end

	method string GetGradeKorean(string grade)
		if grade == "Rare" then return "레어" end
		if grade == "Epic" then return "에픽" end
		if grade == "Unique" then return "유니크" end
		if grade == "Legendary" then return "레전드리" end
		return "없음"
	end

	method integer GetExpToNextLevel(integer level)
		local lv = math.max(1, math.min(self.MaxLevel, level or 1))
		if lv >= self.MaxLevel then
			return 999999999
		end
		-- Authentic 1x MapleStory KMS Lv.1 ~ 200 EXP Table
		local exact = {
			[1] = 15, [2] = 34, [3] = 57, [4] = 92, [5] = 135,
			[6] = 372, [7] = 560, [8] = 840, [9] = 1242,
			[10] = 1242, [11] = 1242, [12] = 1242, [13] = 1242, [14] = 1242,
			[15] = 1490, [16] = 1788, [17] = 2145, [18] = 2574, [19] = 3088,
			[20] = 3705, [21] = 4446, [22] = 5335, [23] = 6402, [24] = 7682,
			[25] = 9218, [26] = 11061, [27] = 13273, [28] = 15927, [29] = 19112,
			[30] = 19112, [31] = 19112, [32] = 19112, [33] = 19112, [34] = 19112,
			[35] = 22934, [36] = 27520, [37] = 33024, [38] = 39628, [39] = 47553,
			[40] = 51357, [41] = 55465, [42] = 59902, [43] = 64694, [44] = 69869,
			[45] = 75458, [46] = 81494, [47] = 88013, [48] = 95054, [49] = 102658,
		}
		if exact[lv] then
			return exact[lv]
		elseif lv < 100 then
			return math.floor(110870 * (1.0678 ^ (lv - 50)))
		else
			return math.floor(2950000 * (1.05462 ^ (lv - 100)))
		end
	end

	method string FormatNumber(number n)
		local v = math.floor(n or 0)
		if v >= 100000000 then
			return string.format("%.2f억", v / 100000000)
		elseif v >= 10000 then
			return string.format("%.1f만", v / 10000)
		end
		return tostring(v)
	end

	method string FormatComma(number n)
		local s = tostring(math.floor(n or 0))
		local k
		while true do
			s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
			if k == 0 then break end
		end
		return s
	end

end