	@ExecSpace("ServerOnly")
	method void ConfigureMonsterForMap(Entity mob, any mapInfo, Vector3 homePos)
		if not isvalid(mob) or not isvalid(mob.Monster) then return end
		local ruid = isvalid(mob.SpriteRendererComponent) and mob.SpriteRendererComponent.SpriteRUID or ""
		local m = mob.Monster
		
		-- Authentic 1x MapleStory rates!
		if mapInfo.mapName == "HenesysHunt1" then
			if ruid == "86acfa20b1b44c4fbd0c7c77b09d6f21" then
				m.MaxHp = 120; m.ExpReward = 20; m.MesoReward = 28; m.TraceReward = 1
			elseif ruid == "bb49c776e7af494b966422f3410d008e" then
				m.MaxHp = 75; m.ExpReward = 14; m.MesoReward = 18; m.TraceReward = 1
			elseif ruid == "f6b87e29b7954d64809ace9bf18868e4" then
				m.MaxHp = 45; m.ExpReward = 8; m.MesoReward = 12; m.TraceReward = 1
			else
				m.MaxHp = mapInfo.mobHp; m.ExpReward = mapInfo.mobExp
				m.MesoReward = mapInfo.mobMeso; m.TraceReward = mapInfo.mobTrace
			end
		else
			m.MaxHp = mapInfo.mobHp or 280
			m.ExpReward = mapInfo.mobExp or 42
			m.MesoReward = mapInfo.mobMeso or 65
			m.TraceReward = mapInfo.mobTrace or 1
		end
		
		-- Apply authentic monster-species-specific Hit & Death sounds!
		if self.SpeciesSoundMap and self.SpeciesSoundMap[ruid] then
			local snd = self.SpeciesSoundMap[ruid]
			m.HitSoundRUID = snd.hit
			m.DeathSoundRUID = snd.die
		end
		
		if homePos then
			m.HomePosition = Vector3(homePos.x, homePos.y, homePos.z)
		elseif isvalid(mob.TransformComponent) then
			local p = mob.TransformComponent.Position
			m.HomePosition = Vector3(p.x, p.y, p.z)
		end
		
		m.Hp = m.MaxHp
		m.RespawnOn = true
		m.RespawnDelay = 1.6
		m.DestroyDelay = 0.50
	end

	@ExecSpace("ServerOnly")
	method any FindAnchoredSpawnSlot(Entity huntMap, Entity nativeMob, any occupiedPositions, number offsetDir)
		if not isvalid(huntMap) or not isvalid(huntMap.FootholdComponent) then return nil end
		if not isvalid(nativeMob) or not isvalid(nativeMob.TransformComponent) then return nil end
		
		local basePos = nativeMob.TransformComponent.Position
		local fhComp = huntMap.FootholdComponent
		
		-- Validate candidate X positions strictly on the EXACT SAME continuous official monster platform
		-- via direct downward raycast (handles multi-segment MapleStory platforms seamlessly without ever touching roofs/props!)
		local offsets = {
			1.25 * offsetDir, -1.25 * offsetDir,
			2.35 * offsetDir, -2.35 * offsetDir,
			3.45 * offsetDir, -3.45 * offsetDir,
			0.95 * offsetDir, -0.95 * offsetDir,
		}
		for _, dx in ipairs(offsets) do
			local cx = basePos.x + dx
			local hitFh = fhComp:Raycast(Vector2(cx, basePos.y + 0.85), Vector2(0, -1), 2.1)
			if hitFh and not hitFh:IsVertical() then
				local cy = hitFh:GetYByX(cx)
				-- Ensure same continuous platform level (within +-0.55m of native official spawn Y)
				-- and ensure solid ground also exists +-0.35m left/right (no cliff-edge dangling!)
				if math.abs(cy - basePos.y) <= 0.55 then
					local fhL = fhComp:Raycast(Vector2(cx - 0.35, cy + 0.55), Vector2(0, -1), 1.4)
					local fhR = fhComp:Raycast(Vector2(cx + 0.35, cy + 0.55), Vector2(0, -1), 1.4)
					if fhL and not fhL:IsVertical() and fhR and not fhR:IsVertical() then
						local finalY = cy + 0.04
						local tooClose = false
						for _, op in ipairs(occupiedPositions) do
							if math.abs(op.x - cx) < 1.05 and math.abs(op.y - finalY) < 0.75 then
								tooClose = true
								break
							end
						end
						if not tooClose then
							return Vector3(cx, finalY, basePos.z)
						end
					end
				end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void PopulateAllHuntingGrounds()
		_GameDataLogic:EnsureInit()
		if not self.SpeciesSoundMap then self:InitSpeciesSounds() end
		
		local configuredMaps = 0
		local totalMobs = 0
		local totalAdded = 0
		
		for _, mapInfo in ipairs(_GameDataLogic.HuntingMaps) do
			local huntMap = _EntityService:GetEntityByPath("/maps/" .. mapInfo.mapName)
			if isvalid(huntMap) then
				configuredMaps = configuredMaps + 1
				local nativeMobs = {}
				local occupiedPositions = {}
				local children = huntMap.Children
				for i = 1, #children do
					local child = children[i]
					if isvalid(child) and isvalid(child.Monster) then
						local pos = isvalid(child.TransformComponent) and child.TransformComponent.Position or Vector3(0, 0, 0)
						self:ConfigureMonsterForMap(child, mapInfo, pos)
						table.insert(nativeMobs, child)
						table.insert(occupiedPositions, pos)
					end
				end
		
				local nativeCount = #nativeMobs
				totalMobs = totalMobs + nativeCount
		
				-- Only augment maps that natively have fewer than TargetDensePerMap official spawn anchors,
				-- and STRICTLY anchor clones onto the exact official monster footholds (zero deformed roof/wall spawns!)
				local desiredTotal = math.min(self.MaxDensePerMap, math.max(nativeCount, self.TargetDensePerMap))
				local needToAdd = math.max(0, desiredTotal - nativeCount)
				if needToAdd > 0 and nativeCount > 0 then
					local added = 0
					local attempts = 0
					local maxAttempts = needToAdd * 3
					while added < needToAdd and attempts < maxAttempts do
						attempts = attempts + 1
						local srcMob = nativeMobs[((attempts - 1) % nativeCount) + 1]
						local dirSign = (attempts % 2 == 0) and 1 or -1
						local spawnPos = self:FindAnchoredSpawnSlot(huntMap, srcMob, occupiedPositions, dirSign)
						if spawnPos then
							local cloned = _SpawnService:SpawnByEntity(srcMob, "MapMob_" .. tostring(added + 1), spawnPos, huntMap)
							if isvalid(cloned) then
								self:ConfigureMonsterForMap(cloned, mapInfo, spawnPos)
								table.insert(occupiedPositions, spawnPos)
								added = added + 1
								totalMobs = totalMobs + 1
								totalAdded = totalAdded + 1
							end
						end
					end
				end
			end
		end
		
		log("[FieldSpawnerLogic] Official-anchor 1x population ready: " .. tostring(totalMobs) .. " monsters (+" .. tostring(totalAdded) .. " anchored) across " .. tostring(configuredMaps) .. " hunting grounds!")
	end

end