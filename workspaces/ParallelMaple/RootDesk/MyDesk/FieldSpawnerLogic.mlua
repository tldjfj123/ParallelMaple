@Logic
script FieldSpawnerLogic extends Logic

	property integer TargetDensePerMap = 38

	property integer MaxDensePerMap = 46

	property any SpeciesSoundMap = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		_GameDataLogic:EnsureInit()
		self:InitSpeciesSounds()
		_TimerService:SetTimerOnce(function()
			self:PopulateAllHuntingGrounds()
		end, 0.6)
	end

